FROM nikolaik/python-nodejs:python3.11-nodejs24-alpine@sha256:6b4d2445257ecb0f71285589a6cf29ab81bbf5584e75c98b5f3bd1054e83811f

# ca-certificates 20261020-r0 distrusts the compromised eMudhra intermediates;
# the base image ships an older version.
RUN apk add --no-cache --upgrade git bash curl 'ca-certificates>=20261020-r0' 'ca-certificates-bundle>=20261020-r0'
# Install scip-python from this checkout (run `npm pack` in packages/pyright-scip
# first), not from npm: npm holds new versions for malware scanning, so a
# release build would otherwise install the previous version.
COPY packages/pyright-scip/sourcegraph-scip-python-*.tgz /tmp/scip-python.tgz
RUN npm install -g /tmp/scip-python.tgz @sourcegraph/src && rm /tmp/scip-python.tgz

CMD ["/bin/sh"]
